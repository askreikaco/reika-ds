{
  "name": "reika-ds",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && vitest run --dir scripts",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "3.0.5"
  },
  "overrides": {
    "@carbon/themes": "11.83.0",
    "@carbon/colors": "11.62.0",
    "@carbon/layout": "11.61.0",
    "@carbon/motion": "11.54.0",
    "@carbon/type": "11.69.0"
  }
}
