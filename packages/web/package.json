{
  "name": "@reika-ds/web",
  "version": "0.3.3",
  "private": false,
  "description": "HTML-string helpers and CSS for apps without React: list item (row, card, compact, tree, table row), section, toolbar, tag, icon button, menu, sheet, timeline item, empty state.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./web.css": "./dist/web.css",
    "./catalog.html": "./dist/catalog.html",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "node ../styles/scripts/lint-consumer.mjs src/web.css"
  },
  "devDependencies": {
    "@reika-ds/tokens": "0.3.3",
    "jsdom": "25.0.1"
  }
}
