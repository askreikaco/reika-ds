{
  "version": 1,
  "carbon": {
    "themes": { "light": "g10", "dark": "g100" }
  },
  "carbon-palette": {
    "tag-background-green": { "light": "green20", "dark": "green80" },
    "tile-1": { "light": "purple70", "dark": "purple60" },
    "tile-2": { "light": "green60", "dark": "green60" },
    "tile-3": { "light": "blue70", "dark": "blue60" },
    "tile-4": { "light": "orange70", "dark": "orange60" },
    "tile-5": { "light": "teal70", "dark": "teal60" },
    "tile-6": { "light": "magenta70", "dark": "magenta60" },
    "tile-7": { "light": "cyan70", "dark": "cyan60" },
    "tile-8": { "light": "red70", "dark": "red60" }
  },
  "carbon-type": {
    "fs-1": "label01",
    "fs-2": "body01",
    "fs-3": "body02",
    "fs-4": "heading03",
    "fs-5": "heading04",
    "fs-6": "heading06"
  },
  "carbon-motion": {
    "duration": { "dur-fast": "fast02", "dur-moderate": "moderate01", "dur-slow": "moderate02" },
    "easing": {
      "ease-standard": ["standard", "productive"],
      "ease-entrance": ["entrance", "productive"],
      "ease-exit": ["exit", "productive"]
    }
  },
  "_sources": {
    "measure-form": "workforce .wf-col-form",
    "measure-text": "workforce .wf-col-text",
    "tile": "giapha .tile (surname tile, row variant)",
    "tile-sm": "giapha .tile (compact rows, pickers)",
    "radius-pill": "giapha chips and tags (the only rounded shape)",
    "shadow-pop": "giapha menus, sheets, toasts (overlays only)"
  },
  "reika": {
    "touch-min": "2.75rem",
    "touch-target": "3rem",
    "row-h": "3.5rem",
    "content-w": "40rem",
    "content-w-wide": "64rem",
    "content-w-max": "99rem",
    "container-narrow": "31.25rem",
    "measure-form": "40rem",
    "measure-text": "48rem",
    "meter-w": "10rem",
    "meter-marker-h": "0.625rem",
    "chart-height-sm": "12.5rem",
    "chart-height-md": "25rem",
    "chart-height-lg": "32.5rem",
    "chart-height-lg-sm": "15rem",
    "chart-donut-height": "15rem",
    "card-pad-inline": "1rem",
    "card-pad-block": "1rem",
    "card-pad-inner": "1rem",
    "card-pad-dense": "0.75rem",
    "card-gap": "1rem",
    "table-cell-pad-block": "0.75rem",
    "table-cell-pad-inline": "1rem",
    "table-cell-pad-inline-dense": "0.25rem",
    "z-layers": { "raised": 1, "sticky": 40, "bar": 50, "shell": 100, "pop": 8000, "modal": 8500, "toast": 9000 },
    "focus-ring-inner": "1px",
    "focus-ring-outer": "2px",
    "breakpoint-md": "42rem",
    "breakpoint-lg": "66rem",
    "breakpoint-lg-px": 1056,
    "icon-sm": 16,
    "icon-md": 20,
    "icon-xl": 32,
    "preview-box-sm": "20rem",
    "preview-box-md": "42rem",
    "preview-box-lg": "66rem",
    "radius-button": 0,
    "radius-card": 0,
    "radius-input": 0,
    "radius-choice": 0,
    "radius-pill": "62.5rem",
    "shadow": "none",
    "shadow-pop": "0 0.125rem 0.375rem var(--cds-shadow)",
    "tile": "2.5rem",
    "tile-sm": "2rem",
    "density": { "default": "normal", "options": ["compact", "normal", "roomy"] }
  },
  "chart": {
    "light": ["#6929c4", "#1192e8", "#b28600", "#ee538b", "#198038"],
    "dark": ["#8a3ffc", "#1192e8", "#b28600", "#ee538b", "#198038"]
  }
}
